# Copy this file to .env on the server and fill in real values.
# .env is gitignored — never commit real secrets.

# Strong Postgres password for prod (the docker-compose.yml default of
# "easysearch" is fine for local dev, not for a server with a public IP).
POSTGRES_PASSWORD=

# Domain pointed at the server's IP (A record) — Caddy requests a
# Let's Encrypt certificate for it automatically on first start.
DOMAIN=
